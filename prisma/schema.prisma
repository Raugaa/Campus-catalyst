// Prisma schema (fixed)

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// College/Institution table
model College {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // College code like "VIT", "IIT", etc.
  location  String
  type      CollegeType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admins   Admin[]
  students Student[]
  faculty  Faculty[]

  @@map("colleges")
}

enum CollegeType {
  UNIVERSITY
  COLLEGE
  INSTITUTE
  POLYTECHNIC
}

// User authentication base
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
  faculty Faculty?
  company Company?
  admin   Admin?

  @@map("users")
  @@index([role])
  @@index([isActive])
}

enum Role {
  STUDENT
  FACULTY
  COMPANY
  ADMIN
}

// Admin - Placement Cell (created by system admin)
model Admin {
  id          String @id @default(cuid())
  userId      String @unique
  name        String
  phone       String?
  department  String? // Placement Cell, Training & Placement, etc.
  
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College @relation(fields: [collegeId], references: [id])
  collegeId String

  @@map("admins")
  @@index([collegeId])
}

// Students - Created by admin
model Student {
  id           String @id @default(cuid())
  userId       String @unique
  firstName    String
  lastName     String
  rollNumber   String @unique
  phone        String?
  department   String
  year         String // FY, SY, TY, LY
  semester     Int
  cgpa         Float?
  skills       String? // JSON array of skills
  resume       String? // File path/URL
  isPlaced     Boolean @default(false)
  
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  college      College        @relation(fields: [collegeId], references: [id])
  collegeId    String
  mentor       Faculty?       @relation(fields: [mentorId], references: [id])
  mentorId     String?
  
  // Relations
  applications Application[]
  interviews   Interview[]
  internships  Internship[]
  placements   Placement[]

  @@map("students")
  @@index([collegeId])
  @@index([mentorId])
  @@index([department])
  @@index([year])
}

model Faculty {
  id          String @id @default(cuid())
  userId      String @unique
  name        String
  department  String
  designation String? // Professor, Assistant Professor, etc.
  phone       String?
  canMentor   Boolean @default(true)
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College   @relation(fields: [collegeId], references: [id])
  collegeId String
  students  Student[] // Students under mentorship

  @@map("faculty")
}

// Companies - Self registration
model Company {
  id          String @id @default(cuid())
  userId      String @unique
  name        String
  website     String?
  location    String
  industry    String?
  size        CompanySize?
  description String?
  isVerified  Boolean @default(false)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  interviews    Interview[]
  internships   Internship[]
  placements    Placement[]

  @@map("companies")
  @@index([isVerified])
}

// Opportunities
model Opportunity {
  id           String @id @default(cuid())
  title        String
  description  String
  location     String
  type         OpportunityType
  duration     String?
  stipend      String?
  salary       String? // For full-time positions
  requirements String?
  skills       String? // JSON array
  deadline     DateTime
  status       OpportunityStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  applications Application[]

  @@map("opportunities")
  @@index([companyId])
  @@index([status])
  @@index([deadline])
  @@index([type])
}

enum OpportunityType {
  INTERNSHIP
  FULL_TIME
  BOTH
}

enum OpportunityStatus {
  PENDING    // Waiting for admin approval
  ACTIVE     // Live
  CLOSED     // Closed
  CANCELLED  // Cancelled
}

// Applications - Enhanced with more workflow stages
model Application {
  id              String @id @default(cuid())
  status          ApplicationStatus @default(PENDING)
  appliedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mentorApproved  Boolean @default(false)
  adminApproved   Boolean @default(false)
  adminRemarks    String?
  mentorRemarks   String?
  
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String

  // Relations to track progression
  interviews    Interview[]
  internship    Internship?
  placement     Placement?

  @@unique([studentId, opportunityId])
  @@map("applications")
  @@index([status])
  @@index([appliedAt])
}

enum ApplicationStatus {
  PENDING           // Initial application
  MENTOR_REVIEW     // With faculty mentor
  ADMIN_REVIEW      // With placement cell
  APPROVED          // Ready for company review
  REJECTED          // Rejected at any stage
  SHORTLISTED       // Company shortlisted
  INTERVIEW_SCHEDULED // Interview scheduled
  INTERVIEWED       // Interview completed
  SELECTED          // Selected by company
  OFFER_MADE        // Offer extended
  OFFER_ACCEPTED    // Student accepted offer
  OFFER_REJECTED    // Student rejected offer
  COMPLETED         // Process completed (internship/job done)
  WITHDRAWN         // Student withdrew application
}

// Interview Tracking
model Interview {
  id            String @id @default(cuid())
  type          InterviewType
  mode          InterviewMode
  scheduledAt   DateTime
  duration      Int? // minutes
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?
  result        InterviewResult?
  round         Int @default(1) // Interview round number
  interviewerName String?
  interviewerEmail String?
  meetingLink   String?
  location      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String

  @@map("interviews")
  @@index([studentId])
  @@index([companyId])
  @@index([scheduledAt])
  @@index([status])
}

enum InterviewType {
  TECHNICAL
  HR
  MANAGERIAL
  CASE_STUDY
  GROUP_DISCUSSION
  PRESENTATION
  CODING_TEST
  FINAL_ROUND
}

enum InterviewMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum InterviewResult {
  SELECTED
  REJECTED
  ON_HOLD
  NEXT_ROUND
}

// Internship Tracking
model Internship {
  id            String @id @default(cuid())
  title         String
  startDate     DateTime
  endDate       DateTime
  stipend       String?
  status        InternshipStatus @default(ACTIVE)
  mentorName    String?
  mentorEmail   String?
  mentorPhone   String?
  workLocation  String?
  workMode      WorkMode @default(HYBRID)
  description   String?
  learningGoals String?
  feedback      String?
  rating        Float? // Out of 5
  certificate   String? // File path/URL
  offerLetter   String? // File path/URL
  completionLetter String? // File path/URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String @unique

  @@map("internships")
  @@index([studentId])
  @@index([companyId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

enum InternshipStatus {
  ACTIVE
  COMPLETED
  TERMINATED
  EXTENDED
  ON_HOLD
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}

// Placement Tracking (Full-time jobs)
model Placement {
  id            String @id @default(cuid())
  title         String
  joiningDate   DateTime?
  salary        String
  location      String
  workMode      WorkMode @default(HYBRID)
  status        PlacementStatus @default(CONFIRMED)
  offerLetter   String? // File path/URL
  acceptanceLetter String? // File path/URL
  bond          String? // Bond details if any
  bondDuration  Int? // months
  department    String?
  reportingManager String?
  hrContact     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String @unique

  @@map("placements")
  @@index([studentId])
  @@index([companyId])
  @@index([status])
  @@index([joiningDate])
}

enum PlacementStatus {
  CONFIRMED
  JOINED
  DEFERRED
  CANCELLED
  TERMINATED
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}